# SentinelAI Environment Configuration Template
# Copy this file to .env and configure your keys
ENV=development
DEBUG=true

# OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hermes Multi-Agent Models
AGENT_NLP_MODEL=google/gemini-2.0-flash-exp:free
AGENT_THREAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_REPORT_MODEL=deepseek/deepseek-chat:free
AGENT_ALERT_MODEL=qwen/qwen-2.5-7b-instruct:free

# Scraper & Ingestion
USE_REAL_CRAWLER=true
CRAWL_INTERVAL_MINUTES=5

# Database
DATABASE_URL=sqlite:///./sentinelai.db

# ── v2.1 Rate Limits (RPM = Requests Per Minute) ─────────────────────────────
X_RPM=300
YOUTUBE_RPM=40
INSTAGRAM_RPM=20
GOOGLE_SUGGEST_RPM=100
WEB_CRAWLER_RPM=60

# ── v2.1 Crawler Settings ─────────────────────────────────────────────────────
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000
SCRAPY_DOWNLOAD_DELAY=2
MAX_CONCURRENT_BROWSERS=2

# ── Kafka (optional — leave blank for demo mode without Kafka) ───────────────
KAFKA_BROKER=
